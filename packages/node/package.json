{
  "name": "@davidapps/telemetry-node",
  "version": "0.1.1",
  "description": "OpenTelemetry-backed telemetry for Node.js services.",
  "keywords": [
    "analytics",
    "node",
    "observability",
    "opentelemetry",
    "telemetry"
  ],
  "author": "David Ilie <david@davidilie.com> (https://davidilie.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidIlie/davidapps-telemetry.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/DavidIlie/davidapps-telemetry#readme",
  "bugs": {
    "url": "https://github.com/DavidIlie/davidapps-telemetry/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.yml"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.mts",
        "default": "./dist/register.mjs"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/register.ts --format esm,cjs --dts --tsconfig tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@davidapps/telemetry-core": "workspace:*",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
