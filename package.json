{
  "name": "davidapps-telemetry-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Small, self-hosted telemetry SDKs for Grafana Alloy, Tempo, VictoriaLogs, and Prometheus.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "licenses:sync": "node scripts/sync-package-licenses.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "upstream:check": "node scripts/check-upstream.mjs",
    "packages:check": "pnpm --recursive --filter './packages/**' exec publint",
    "packages:pack": "node scripts/pack-packages.mjs",
    "packages:smoke": "node scripts/package-smoke.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:verify": "pnpm check && pnpm test && pnpm build && pnpm packages:check && pnpm licenses:check && pnpm upstream:check && pnpm packages:smoke",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm release:verify"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@types/node": "26.2.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "turbo": "2.10.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
