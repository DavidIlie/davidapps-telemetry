{
  "name": "@davidapps/telemetry-react-native",
  "version": "0.1.0",
  "description": "Small OpenTelemetry/OTLP client for React Native and Expo applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidIlie/davidapps-telemetry.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/DavidIlie/davidapps-telemetry#readme",
  "bugs": { "url": "https://github.com/DavidIlie/davidapps-telemetry/issues" },
  "engines": { "node": ">=20" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./expo": {
      "import": {
        "types": "./dist/expo.d.mts",
        "default": "./dist/expo.mjs"
      },
      "require": {
        "types": "./dist/expo.d.cts",
        "default": "./dist/expo.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/expo.ts --format esm,cjs --dts",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@davidapps/telemetry-core": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "expo-constants": ">=57.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.75.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "expo": "57.0.13",
    "expo-constants": "57.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
