{
  "name": "@davidilie/telemetry-next",
  "version": "0.1.2",
  "description": "Runtime-safe Next.js telemetry backed by @vercel/otel.",
  "keywords": [
    "analytics",
    "nextjs",
    "observability",
    "opentelemetry",
    "telemetry",
    "vercel"
  ],
  "author": "David Ilie <david@davidilie.com> (https://davidilie.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidIlie/davidapps-telemetry.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/DavidIlie/davidapps-telemetry#readme",
  "bugs": {
    "url": "https://github.com/DavidIlie/davidapps-telemetry/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.yml"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/node.ts --format esm,cjs --dts --tsconfig tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@davidilie/telemetry-core": "workspace:*",
    "@davidilie/telemetry-node": "workspace:*",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@vercel/otel": "2.1.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2.0.0",
    "next": ">=16.0.0 <17.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.0",
    "@types/node": "25.0.10",
    "next": "16.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
